{
  "name": "incu-qq-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QQ 群客服机器人（官方 SDK）+ 飞书反馈群提醒，OAI 兼容模型驱动",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:op": "op run --env-file .env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:op": "op run --env-file .env -- node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "openai": "7.8.0",
    "sharp": "0.35.4",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
