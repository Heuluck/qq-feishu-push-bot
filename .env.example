# 复制成 .env 后填入真实凭据（.env 不会进版本库）。程序只在启动时校验，不会打印凭据内容。

# ===== QQ 机器人（QQ 开放平台 → 机器人管理 → 开发设置）=====
QQBOT_APP_ID=PASTE_QQ_APP_ID
QQBOT_APP_SECRET=PASTE_QQ_APP_SECRET
# 可选：只响应这个群（群 openid）。留空 = 机器人所在的每个群都响应。
# 首次留空启动，机器人收到消息时会把它看到的群 openid 打进日志，复制过来即可。
QQ_GROUP_OPENID=

# ===== 飞书自建应用（open.feishu.cn → 开发者后台 → 创建企业自建应用）=====
LARK_APP_ID=PASTE_LARK_APP_ID
LARK_APP_SECRET=PASTE_LARK_APP_SECRET
# 可选：反馈群 chat_id（oc_ 开头）。留空 = 自动识别（机器人恰好只在一个群里时）。
LARK_FEEDBACK_CHAT_ID=

# ===== 模型（OpenAI 兼容端点，二选一）=====
# DeepSeek:  https://api.deepseek.com             模型 deepseek-flash
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4 模型 glm-5.3-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=PASTE_LLM_API_KEY
LLM_MODEL=deepseek-flash

# 思考（推理）档位，透传给端点的 reasoning_effort。
# 默认 none（关闭）：推理内容计入 LLM_MAX_TOKENS，开着会让长截图这类任务把预算吃光、正文为空。
# 换 GLM 时必须改成 low —— 它的思考关不掉，填 none 会 400。填 default = 不带这个参数。
# LLM_REASONING_EFFORT=none

# ===== 可选项 =====
# 豁免名单：逗号分隔的用户 openid，不受分钟级/群级/转交每小时限制，每日额度单独算
# PRIVILEGED_USERS=0594D117CCDA12B06A25EE5E7DB5F5B1
# PRIVILEGED_LIMIT_PER_DAY=100

# 频次与每日配额
# RATE_LIMIT_PER_MINUTE=6              # 单用户每分钟
# RATE_LIMIT_PER_GROUP_PER_MINUTE=40   # 单群每分钟
# REPLY_LIMIT_PER_USER_PER_DAY=10      # 单用户每日
# REPLY_LIMIT_GLOBAL_PER_DAY=100       # 全机器人每日（成本护栏）

# 本地对话缓冲（平台没给上下文时的兜底）
# HISTORY_ENABLED=true
# HISTORY_WINDOW_MINUTES=360         # 存储窗口：保留最近 6 小时
# HISTORY_MAX_STORED=50              # 缓冲区最多存几条（调大注入条数时才有意义）
# HISTORY_INJECT_MINUTES=60          # 会话窗口：闲置这么久就当开了新会话（比存储窗口紧，避免旧话题串台）
# HISTORY_MAX_ENTRIES=30             # 最多带几轮历史（给小了会把机器人自己刚说的话挤出窗口）

# 超长截断
# QUESTION_MAX_CHARS=4000              # 用户单条提问
# CONTEXT_MAX_CHARS=3000               # 上下文整段
# CONTEXT_MESSAGE_MAX_CHARS=600        # 上下文里单条消息
# REPLY_MAX_CHUNKS=3                   # 主回复最多分几条发（平台限同一 msg_id 最多 5 条被动回复）

# 其他
# DATA_RETENTION_DAYS=30               # 数据文件保留天数（转交留档/调试转储/配额归档）
# LLM_MAX_TOKENS=1024
# LLM_DEADLINE_MS=45000
# IMG_MAX_EDGE=1920                   # 客户端缩放长边上限（对齐模型内部目标，见 README）
# IMG_MAX_COUNT=2                     # 单条消息自带的图最多几张
# IMG_CONTEXT_MAX_COUNT=5             # 历史里同一用户的图最多几张（挂在图片到来的那一轮上）
# IMG_DAILY_LIMIT_PER_USER=10         # 同一用户每天最多**新读**几张图（缓存命中的不重复扣）
# FORWARD_LIMIT_PER_HOUR=5
# FORWARD_TOPIC_WINDOW_HOURS=24
# KB_PATH=kb/kb.yaml
# DATA_DIR=data
# LOG_LEVEL=info

# 容器以非 root 运行（见 docker-compose.yml）。这两个值必须等于宿主机部署账号的
# `id -u` / `id -g`，否则 bind mount 的 data/ 目录写不进去、启动即失败。
# 默认 1000；服务器上填成部署账号自己的 uid/gid（例如 heuluck 是 1001）。
# BOT_UID=1000
# BOT_GID=1000
